[Unit]
Description=Record tennis paper simulation health and results

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@HOME@/kalshi-us-open
ExecStart=/usr/bin/python3 @HOME@/kalshi-us-open/paper_report.py --record
StandardOutput=append:@HOME@/kalshi-us-open/data/live/paper_monitor.log
StandardError=inherit
